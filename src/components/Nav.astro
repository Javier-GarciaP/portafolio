---
import { CV_URL } from "../data/projects";

const links = [
  { href: "/#casos", label: "Casos" },
  { href: "/#comunidad", label: "Comunidad" },
  { href: "/#como-trabajo", label: "Cómo trabajo" },
  { href: "/#sobre-mi", label: "Sobre mí" },
  { href: "/#contacto", label: "Contacto" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-raised bg-ground/95 backdrop-blur">
  <nav
    aria-label="Principal"
    class="page-x mx-auto flex h-16 max-w-[1440px] items-center justify-between"
  >
    <a href="/" class="flex items-center gap-2.5 font-display text-[15px] font-bold text-ink">
      <span aria-hidden="true" class="inline-block size-[14px] rotate-45 bg-accent"></span>
      José Javier García
    </a>
    <div class="hidden items-center gap-7 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm text-muted hover:text-ink focus-visible:text-ink"
          >
            {l.label}
          </a>
        ))
      }
    </div>
    <a href={CV_URL} download class="btn btn-accent !py-2.5">Descargar CV</a>
  </nav>
</header>
