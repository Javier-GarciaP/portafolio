---
import Scene from "./Scene.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const code =
  {
    "bodegon-goyo": "bodegon",
    "laboratorio-clinico-vitaly": "vitaly",
    decoartesjb: "decoartes",
  }[project.slug] ?? project.slug;
/* Literal classes so Tailwind generates them (task 1.2 tokens). */
const fieldClasses: Record<string, string> = {
  bodegon: "bg-field-bodegon",
  vitaly: "bg-field-vitaly",
  decoartes: "bg-field-decoartes",
  sprixel: "bg-field-sprixel",
  fosforo: "bg-field-fosforo",
};
const sceneHref = `/${project.kind === "open" ? "comunidad" : "casos"}/${project.slug}`;
---

<section class={`ch-${code} ${fieldClasses[code]}`} data-rail={code} id={`cap-${code}`}>
  <div class="page-x mx-auto max-w-[1440px]">
    <a
      href={sceneHref}
      class="scene-link block"
      aria-label={`Ver el detalle de ${project.name}`}
    >
      <Scene
        scene={project.scene}
        alt={project.sceneAlt}
        className="mx-auto max-w-[1056px] scene-lift"
      />
    </a>
    <div class="relative z-10 grid -mt-6 gap-6 pb-16 md:-mt-10 md:grid-cols-[36%_1fr] md:gap-12">
      <h3 class="font-display text-[26px] font-extrabold tracking-tight text-ink md:text-[34px]">
        {project.name}
      </h3>
      <div>
        <p class="text-[13px] font-semibold text-muted">{project.meta}</p>
        <p class="mt-3 max-w-[632px] text-[16px] leading-relaxed text-ink/90">
          {project.description}
        </p>
        <p class="mt-3 flex items-start gap-2 text-[14px] text-muted">
          <span aria-hidden="true" class="mt-1.5 inline-block size-2 shrink-0 bg-accent"></span>
          {project.result}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {
            project.link && (
              <a href={project.link.href} class="btn btn-accent" rel="noopener">
                {project.link.label}
              </a>
            )
          }
          <a href={sceneHref} class="btn btn-light">Ver más</a>
        </div>
      </div>
    </div>
  </div>
</section>
