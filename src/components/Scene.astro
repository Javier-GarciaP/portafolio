---
interface Props {
  scene: string;
  alt: string;
  eager?: boolean;
  className?: string;
}
const { scene, alt, eager = false, className = "" } = Astro.props;
const light = scene.replace("/scenes/", "/light/");
---

<div class={`scene-pan relative ${className}`}>
  <img
    class="pixel block h-auto w-full"
    src={scene}
    data-full={scene}
    data-light={light}
    width="1056"
    height="816"
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
  <div class="scene-markers absolute inset-0" aria-hidden="true"></div>
</div>

<style>
  /* Stepped pixel loops per scene (task 3b.3). Positions are % of the scene. */
  .scene-markers {
    --f: transparent;
  }
  :global(.ch-hero) .scene-markers::before,
  :global(.ch-hero) .scene-markers::after {
    content: "";
    position: absolute;
    width: 2.2%;
    aspect-ratio: 1;
  }
  /* Hero: the Wi-Fi in the bubble blinks off and on. */
  :global(.ch-hero) .scene-markers::before {
    left: 50.5%;
    top: 23%;
    background: var(--color-ink);
    animation: loop-flicker steps(2) 1.4s infinite;
  }
  /* Hero: desk lamp flickers. */
  :global(.ch-hero) .scene-markers::after {
    left: 63.5%;
    top: 40%;
    background: var(--color-accent);
    opacity: 0.5;
    animation: loop-flicker steps(2) 1.9s infinite;
    animation-delay: 0.4s;
  }
  /* Bodegón: the scale screen alternates; a hanging lantern blinks. */
  :global(.ch-bodegon) .scene-markers::before {
    content: "";
    position: absolute;
    left: 37%;
    top: 47%;
    width: 2%;
    aspect-ratio: 1;
    background: var(--color-success);
    animation: loop-flicker steps(2) 1.2s infinite;
  }
  :global(.ch-bodegon) .scene-markers::after {
    content: "";
    position: absolute;
    left: 76%;
    top: 38%;
    width: 1.6%;
    aspect-ratio: 1;
    background: var(--color-danger);
    animation: loop-flicker steps(2) 1.7s infinite;
    animation-delay: 0.6s;
  }
  /* Vitaly: the Wi-Fi bubble alternates crossed-out and check; the monitor flickers. */
  :global(.ch-vitaly) .scene-markers::before {
    content: "";
    position: absolute;
    left: 37.5%;
    top: 43%;
    width: 3.4%;
    background: var(--color-ink);
    animation: loop-flicker steps(2) 1.6s infinite;
  }
  :global(.ch-vitaly) .scene-markers::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.2%;
    aspect-ratio: 1;
    background: var(--color-teal);
    opacity: 0.4;
    animation: loop-flicker steps(2) 1.3s infinite;
    animation-delay: 0.3s;
  }
  /* DecoartesJB: the string lights twinkle in batches. */
  :global(.ch-decoartes) .scene-markers::before,
  :global(.ch-decoartes) .scene-markers::after {
    content: "";
    position: absolute;
    width: 1.4%;
    aspect-ratio: 1;
    background: #ffd65c;
    animation: loop-flicker steps(2) 1.1s infinite;
  }
  :global(.ch-decoartes) .scene-markers::before {
    left: 28%;
    top: 33%;
  }
  :global(.ch-decoartes) .scene-markers::after {
    left: 63%;
    top: 29%;
    animation-delay: 0.55s;
  }
  /* Sprixel: the cursor paints on the canvas; the robot blinks. */
  :global(.ch-sprixel) .scene-markers::before {
    content: "";
    position: absolute;
    left: 60%;
    top: 44%;
    width: 1.6%;
    aspect-ratio: 1;
    background: #ffd65c;
    animation: loop-move steps(1) 1.6s infinite;
  }
  :global(.ch-sprixel) .scene-markers::after {
    content: "";
    position: absolute;
    left: 53%;
    top: 65%;
    width: 1.4%;
    aspect-ratio: 1;
    background: var(--color-success);
    animation: loop-flicker steps(2) 2.2s infinite;
  }
  /* Fósforo: the flame dances in 3 steps. */
  :global(.ch-fosforo) .scene-markers::before {
    content: "";
    position: absolute;
    left: 67%;
    top: 12%;
    width: 1.8%;
    background: var(--color-accent);
    animation: loop-dance steps(1) 0.9s infinite;
  }
  /* Fósforo: the terminal cursor blinks. */
  :global(.ch-fosforo) .scene-markers::after {
    content: "";
    position: absolute;
    left: 57%;
    top: 55%;
    width: 1.2%;
    aspect-ratio: 1;
    background: var(--color-ink);
    animation: loop-flicker steps(2) 1s infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-markers::before,
    .scene-markers::after {
      animation: none !important;
      display: none;
    }
  }
  :global(html[data-light="on"]) .scene-markers::before,
  :global(html[data-light="on"]) .scene-markers::after {
    animation: none !important;
    display: none;
  }
</style>
